# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: Supabase Service Role Key (for server-side operations)
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key


NEXT_PUBLIC_APP_NAME=Paltra
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=__fill_me__
NEXT_PUBLIC_SUPABASE_ANON_KEY=__fill_me__
SUPABASE_SERVICE_ROLE_KEY=__fill_me__
# Optional: Support contact email used on Auth page
VITE_SUPPORT_EMAIL=support@example.com

# Default email recipients for Call-Ins (semicolon/comma/space separated)
VITE_CALLIN_EMAIL_TO=
VITE_CALLIN_EMAIL_CC=

# Outlook Web configuration (used only if enabling Outlook compose links)
VITE_OUTLOOK_HOST=outlook.office.com
VITE_OUTLOOK_COMPOSE_STYLE=owa
VITE_OUTLOOK_REALM=
VITE_OUTLOOK_LOGIN_HINT=

# Optional: per-carrier recipient mapping
# Option A: JSON map of carrier -> recipients
# Example: {"ESTES":"estes@company.com","R&L":["rl@company.com","dispatch@company.com"]}
VITE_CARRIER_EMAIL_MAP=

# Option B: Per-carrier env variables (override default VITE_CALLIN_EMAIL_TO)
# Suffix format: uppercase carrier; spaces/hyphens -> _ ; & -> AND
# Examples:
# VITE_CALLIN_EMAIL_TO_ESTES=estes@company.com
# VITE_CALLIN_EMAIL_TO_R_AND_L=rl@company.com
# VITE_CALLIN_EMAIL_TO_T_FORCE=tforce@company.com
